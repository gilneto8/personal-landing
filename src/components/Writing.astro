---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const latest = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const slugFor = (id: string) => id.replace(/^\d+_/, "");
---

<section
  id="writing"
  class="px-6 md:px-12 lg:px-24 py-20 border-t-2 border-[var(--border-muted)]"
>
  <div class="flex items-center gap-4 mb-12">
    <h2
      class="text-sm font-mono font-bold bg-[var(--accent-primary)] text-[var(--bg-primary)] px-3 py-1.5 uppercase tracking-wider"
    >
      Writing
    </h2>
    <div class="flex-1 h-[2px] bg-[var(--border-muted)]"></div>
    <a
      href="/blog"
      class="text-xs font-mono text-[var(--text-muted)] hover:text-[var(--accent-primary)] uppercase tracking-wider transition-colors"
      >All posts →</a
    >
  </div>

  {
    latest.length === 0 ? (
      <p class="text-[var(--text-muted)] font-mono text-sm">
        First post coming soon.
      </p>
    ) : (
      <ul class="space-y-0">
        {latest.map((post) => (
          <li class="border-t border-[var(--border-muted)] last:border-b py-6 group">
            <a href={`/blog/${slugFor(post.id)}`} class="block">
              <div class="flex flex-col md:flex-row md:items-baseline md:gap-6">
                <time
                  class="text-xs font-mono text-[var(--accent-primary)] uppercase tracking-wider md:w-28 flex-shrink-0 mb-2 md:mb-0"
                  datetime={post.data.pubDate.toISOString()}
                >
                  {post.data.pubDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <div class="flex-1">
                  <h3 class="text-lg md:text-xl font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-2">
                    {post.data.title}
                  </h3>
                  <p class="text-[var(--text-secondary)] text-sm">
                    {post.data.description}
                  </p>
                </div>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
