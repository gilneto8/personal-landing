---
import { getCollection } from "astro:content";

const allPosts = await getCollection("posts", ({ data }) => !data.draft);
const latest = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const slugFor = (id: string) => id.replace(/^\d+_/, "");
---

<section id="writing" class="relative px-5 md:px-12 lg:px-20 py-24 md:py-32">
  <div class="flex items-center gap-4 mb-10 md:mb-14" data-reveal>
    <span data-thread class="font-display italic text-2xl text-[var(--sun-400)]">05</span>
    <span class="font-mono text-xs uppercase tracking-[0.25em] text-[var(--aqua-300)]">Writing</span>
    <span class="flex-1 h-px bg-[var(--ink-600)]"></span>
    <a href="/rss.xml" class="link-slide font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--aqua-300)] hover:text-[var(--mist-50)] transition-colors">RSS</a>
    <a href="/blog" class="link-slide font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sun-400)]">All posts →</a>
  </div>

  {
    latest.length === 0 ? (
      <p class="text-[var(--aqua-300)] font-mono text-sm">First post coming soon.</p>
    ) : (
      <ul>
        {latest.map((post, i) => (
          <li data-reveal style={`--d:${i * 90}ms`} class="border-t border-[var(--ink-600)] last:border-b">
            <a href={`/blog/${slugFor(post.id)}`} class="post-row group relative block py-8 md:py-10 overflow-hidden">
              <span aria-hidden class="post-wipe absolute inset-0 bg-[var(--ink-700)]"></span>
              <div class="relative flex flex-col md:flex-row md:items-baseline gap-2 md:gap-10 md:px-4">
                <time class="font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--sun-400)] md:w-32 shrink-0" datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
                </time>
                <div class="flex-1">
                  <h3 class="font-display text-3xl md:text-5xl text-[var(--mist-50)] group-hover:text-[var(--sun-400)] transition-colors duration-300 mb-2">
                    {post.data.title}
                  </h3>
                  <p class="text-[var(--mist-200)]/80 text-[15px] max-w-3xl">{post.data.description}</p>
                </div>
                <span aria-hidden class="post-arrow hidden md:block font-display text-4xl text-[var(--sun-400)]">↗</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .post-wipe {
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.5s var(--ease-snap);
  }
  .post-row:hover .post-wipe { transform: scaleY(1); }
  .post-arrow {
    opacity: 0;
    transform: translate(-8px, 8px);
    transition: opacity 0.4s var(--ease-snap), transform 0.5s var(--ease-snap);
  }
  .post-row:hover .post-arrow { opacity: 1; transform: none; }
</style>
