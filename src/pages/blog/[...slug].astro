---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import Subscribe from "../../components/Subscribe.astro";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/^\d+_/, "") },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const slugFor = (id: string) => id.replace(/^\d+_/, "");
const slug = slugFor(post.id);

// Two other posts to read next: most shared tags first, then newest.
const readNext = (await getCollection("posts", ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    p,
    shared: p.data.tags.filter((t: string) => post.data.tags.includes(t)).length,
  }))
  .sort(
    (a, b) =>
      b.shared - a.shared ||
      b.p.data.pubDate.getTime() - a.p.data.pubDate.getTime(),
  )
  .slice(0, 2)
  .map(({ p }) => p);

const canonical =
  post.data.canonical ??
  new URL(`/blog/${post.id.replace(/^\d+_/, "")}`, Astro.site ?? Astro.url)
    .href;

const blogPostingJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@id": "https://gil-neto.com/#gil" },
  publisher: { "@id": "https://gil-neto.com/#gil" },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  url: canonical,
  keywords: post.data.tags.join(", "),
  inLanguage: "en",
};
---

<Layout
  title={`${post.data.title} — Gil Neto`}
  description={post.data.description}
  type="article"
  ogImage={post.data.cover ?? "/og-image.png"}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(blogPostingJsonLd)}
  />

  <main class="px-6 md:px-12 lg:px-20 py-20 max-w-5xl mx-auto">
    <div class="mb-12">
      <a
        href="/blog"
        class="text-sm font-mono text-[var(--text-muted)] hover:text-[var(--accent-primary)] transition-colors"
        >← All writing</a
      >
    </div>

    <article data-read-depth={slug}>
      <header class="mb-12">
        <div class="flex flex-wrap gap-2 mb-4">
          {
            post.data.tags.map((t: string) => (
              <span class="text-xs px-2 py-1 bg-[var(--bg-secondary)] border border-[var(--border-muted)] text-[var(--text-muted)] font-mono uppercase tracking-wider">
                {t}
              </span>
            ))
          }
        </div>
        <h1
          class="text-4xl md:text-5xl font-medium tracking-tight mb-6 text-[var(--text-primary)] leading-tight"
        >
          {post.data.title}
        </h1>
        <div
          class="flex items-center gap-4 text-sm font-mono text-[var(--text-muted)]"
        >
          <time datetime={post.data.pubDate.toISOString()}>
            {
              post.data.pubDate.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          <span>·</span>
          <span>Gil Neto</span>
        </div>
      </header>

      <div class="prose-content text-[var(--text-secondary)] leading-relaxed">
        <Content />
      </div>
    </article>
    {
      readNext.length > 0 && (
        <nav class="read-next" aria-label="Read next">
          <span class="read-next-kicker">Read next</span>
          <ul>
            {readNext.map((p) => (
              <li>
                <a
                  href={`/blog/${slugFor(p.id)}`}
                  data-umami-event="read-next"
                  data-umami-event-from={slug}
                  data-umami-event-to={slugFor(p.id)}
                >
                  <span class="read-next-title">{p.data.title}</span>
                  <span class="read-next-desc">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <Subscribe variant="post" />
    <footer class="post-cta">
      <div>
        <span class="post-cta-kicker">Open to fractional and contract build work</span>
        <p>The architecture, the first working version and the handover. Remote across EU timezones, based in Lisbon.</p>
      </div>
      <a class="post-cta-btn" href="/work" data-umami-event="post-cta-work" data-umami-event-from={slug}>How I work, and prices</a>
    </footer>
  </main>
</Layout>

<script>
  // Scroll depth through the article body, sent once per milestone, so a
  // one-page visit still shows whether the post was read.
  const article = document.querySelector<HTMLElement>("article[data-read-depth]");
  if (article) {
    const post = article.dataset.readDepth;
    const sent = new Set<number>();
    const check = () => {
      const r = article.getBoundingClientRect();
      const seen = (window.innerHeight - r.top) / r.height;
      for (const m of [25, 50, 75, 100]) {
        if (seen * 100 >= m && !sent.has(m)) {
          const umami = (window as any).umami;
          if (!umami) return; // tracker not loaded yet: retry on the next scroll
          sent.add(m);
          umami.track("read-depth", { post, depth: m });
        }
      }
      if (sent.size === 4) window.removeEventListener("scroll", check);
    };
    window.addEventListener("scroll", check, { passive: true });
  }
</script>

<style>
  .read-next { margin: 56px 0; padding-top: 32px; border-top: 1px solid var(--line); }
  .read-next-kicker { font-size: 14px; color: var(--teal); display: flex; align-items: center; gap: 8px; margin-bottom: 20px; }
  .read-next-kicker::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .read-next ul { display: grid; gap: 20px; }
  .read-next a { display: grid; gap: 6px; }
  .read-next-title { font-size: 1.25rem; font-weight: 500; color: var(--bright); transition: color .3s; }
  .read-next a:hover .read-next-title, .read-next a:focus-visible .read-next-title { color: var(--teal); }
  .read-next-desc { color: var(--text); max-width: 65ch; }
  .post-cta { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; }
  .post-cta-kicker { font-size: 14px; color: var(--pink); display: flex; align-items: center; gap: 8px; }
  .post-cta-kicker::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .post-cta p { margin: 8px 0 0; color: var(--text); max-width: 52ch; }
  .post-cta-btn { border: 1px solid var(--pink); color: var(--bright); border-radius: 999px; padding: 14px 26px; font-size: 16px; transition: background .3s, color .3s; }
  .post-cta-btn:hover { background: var(--pink); color: var(--bg); }
</style>
<style is:global>
  .prose-content {
    font-size: 1.0625rem;
    line-height: 1.75;
    max-width: 70ch;
  }
  @media (min-width: 1024px) {
    .prose-content {
      max-width: 75ch;
    }
  }
  .prose-content h2 {
    font-size: 1.75rem;
    font-weight: 500;
    margin-top: 3rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }
  .prose-content h3 {
    font-size: 1.25rem;
    font-weight: 500;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }
  .prose-content p {
    margin-bottom: 1.25rem;
  }
  .prose-content ul,
  .prose-content ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .prose-content ul {
    list-style-type: disc;
  }
  .prose-content ol {
    list-style-type: decimal;
  }
  .prose-content li {
    margin-bottom: 0.5rem;
  }
  .prose-content a {
    color: var(--accent-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-content a:hover {
    text-decoration-thickness: 2px;
  }
  .prose-content code {
    background: var(--bg-secondary);
    border: 1px solid var(--border-muted);
    padding: 0.125rem 0.375rem;
    font-size: 0.9em;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }
  .prose-content pre {
    background: var(--bg-secondary);
    border: 1px solid var(--border-muted);
    border-left: 4px solid var(--accent-primary);
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    font-size: 0.9em;
    line-height: 1.6;
  }
  .prose-content pre code {
    background: transparent;
    border: 0;
    padding: 0;
  }
  .prose-content blockquote {
    border-left: 4px solid var(--accent-secondary);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--text-muted);
    font-style: italic;
  }
  .prose-content hr {
    border: 0;
    border-top: 2px solid var(--border-muted);
    margin: 3rem 0;
  }
  .prose-content strong {
    color: var(--text-primary);
    font-weight: 500;
  }
  .prose-content table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
    font-size: 0.95em;
  }
  .prose-content th,
  .prose-content td {
    border: 1px solid var(--border-muted);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }
  .prose-content th {
    background: var(--bg-secondary);
    font-weight: 500;
    color: var(--text-primary);
  }
</style>
