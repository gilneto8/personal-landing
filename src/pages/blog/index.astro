---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import "../../styles/global.css";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const slugFor = (id: string) => id.replace(/^\d+_/, "");
---

<Layout
  title="Writing — Gil Neto"
  description="Technical writeups on B2B SaaS, infrastructure, founder-engineering, and AI-augmented solo development."
>
  <main class="px-6 md:px-12 lg:px-24 py-20 max-w-5xl mx-auto">
    <div class="mb-16">
      <a
        href="/"
        class="text-sm font-mono text-[var(--text-muted)] hover:text-[var(--accent-primary)] transition-colors"
        >← gil-neto.com</a
      >
      <h1
        class="text-5xl md:text-7xl font-black tracking-tighter mt-6 mb-4 text-[var(--text-primary)]"
      >
        WRITING
      </h1>
      <p class="text-lg text-[var(--text-secondary)] max-w-2xl">
        Technical writeups on infrastructure, founder-engineering, and shipping
        B2B utilities solo.
      </p>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-[var(--text-muted)] font-mono">
          No posts yet. Check back soon.
        </p>
      ) : (
        <ul class="space-y-0">
          {posts.map((post) => (
            <li class="border-t border-[var(--border-muted)] last:border-b py-8 group">
              <a href={`/blog/${slugFor(post.id)}`} class="block">
                <div class="flex flex-col md:flex-row md:items-baseline md:gap-8">
                  <time
                    class="text-xs font-mono text-[var(--accent-primary)] uppercase tracking-wider md:w-32 flex-shrink-0 mb-2 md:mb-0"
                    datetime={post.data.pubDate.toISOString()}
                  >
                    {post.data.pubDate.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                  <div class="flex-1">
                    <h2 class="text-xl md:text-2xl font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors mb-2">
                      {post.data.title}
                    </h2>
                    <p class="text-[var(--text-secondary)] mb-3">
                      {post.data.description}
                    </p>
                    <div class="flex flex-wrap gap-2">
                      {post.data.tags.map((t: string) => (
                        <span class="text-xs px-2 py-1 bg-[var(--bg-secondary)] border border-[var(--border-muted)] text-[var(--text-muted)] font-mono">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Layout>
