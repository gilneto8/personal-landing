    .rel :global(.lk), .loop :global(.ring) { stroke-dashoffset: 0; transition: none; }
    .swap b, .plug :global(.inslot), .plug :global(.chip rect), .loop :global(.halo), .chart :global(*) { animation: none !important; }
    .swap b:first-child, .plug :global(.inslot:first-of-type) { opacity: 1; transform: none; }
    .loop :global(.orb) { display: none; }
  }
</style>
