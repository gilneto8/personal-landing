---
// Unlisted: no link from the site, noindex, kept out of the sitemap (Gil, 2026-11-25).
// Data: src/data/model-bench.json, written by `python3 report.py --export` in the model-bench repo.
// Identity = the home page: chapters with a colour glow, big type, little text per screen.
// Motion only upward, in depth, or around a loop (Gil's taste); reveals play once on scroll.
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import "../../styles/home.css";
import data from "../../data/model-bench.json";

const cat = data.catalog as any;
const cycle = data.cycles[data.cycles.length - 1] as any;
const summ = cycle.summary as Record<string, any>;
const nTasks = Object.values(cycle.suites as Record<string, number>).reduce((a, b) => a + b, 0);
const dateLabel = (d: string) => new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

// One colour per family, used everywhere on the page.
const FAMILY_COLOR: Record<string, string> = {
  Fable: "#ffb547", Opus: "#7aa2ff", Sonnet: "#c792ea", Haiku: "#2ec4b6",
  "Gemini Neon": "#ff5d8f", "Gemini Argon": "#ff8a65", "Gemini Carbon": "#9fb3d9", "Gemini Hydrogen": "#7fe3c4", "Gemini Flash": "#e6d27a",
};
const models = (cat.models as any[]).map((m) => ({ ...m, color: FAMILY_COLOR[m.family] ?? "#8a97b8" }));
const tested = Object.keys(summ).sort((a, b) => summ[b].score - summ[a].score);

// ── the plug: the brain stays put; models take turns in its model slot ─────────────────────
const SHELF = ["Opus 5.5", "Fable 5.2", "Haiku 5.5", "Sonnet 5.5", "Gemini 4 Neon"];
const SHELF_COLOR = ["#7aa2ff", "#ffb547", "#2ec4b6", "#c792ea", "#ff5d8f"];
const FIXED: [string, string][] = [["Notes", "markdown, git"], ["Tools", "index · search"], ["Rules", "AGENTS.md"], ["Seam", "one env file"]];
function plug(): string {
  const W = 560, cw = 98, ch = 28, gap = 8, shelfY = 22;
  const sx = (i: number) => (W - (SHELF.length * cw + (SHELF.length - 1) * gap)) / 2 + i * (cw + gap);
  const bx = 20, by = 150, bw = W - 40, bh = 190, slotW = 150, slotH = 34, slotX = (W - slotW) / 2, slotY = by + 30;
  let g = `<text class="ax" x="${W / 2}" y="10" text-anchor="middle">models · any company</text>`;
  // connectors: from each chip down to the slot, drawn while that chip is in use
  SHELF.forEach((_, i) => {
    const x = sx(i) + cw / 2, y0 = shelfY + ch, ym = shelfY + ch + 44;
    g += `<path class="wire" style="--i:${i};--c:${SHELF_COLOR[i]}" pathLength="1" d="M${x} ${y0} V${ym} H${W / 2} V${slotY}"/>`;
  });
  g += `<rect class="brain" x="${bx}" y="${by}" width="${bw}" height="${bh}" rx="16"/><text class="ax" x="${bx + 16}" y="${by + 20}">second brain</text>`;
  g += `<rect class="slot" x="${slotX}" y="${slotY}" width="${slotW}" height="${slotH}" rx="10"/><text class="ax" x="${W / 2}" y="${slotY + slotH + 16}" text-anchor="middle">model slot</text>`;
  g += `<circle class="port" cx="${W / 2}" cy="${slotY}" r="3"/>`;
  const fw = (bw - 32 - 3 * 10) / 4;
  FIXED.forEach(([a, b], i) => {
    const x = bx + 16 + i * (fw + 10), y = by + 108;
    g += `<rect class="fix" x="${x}" y="${y}" width="${fw}" height="58" rx="10"/><text class="lb" x="${x + 12}" y="${y + 24}">${a}</text><text class="ax" x="${x + 12}" y="${y + 42}">${b}</text>`;
  });
  SHELF.forEach((n, i) => {
    const x = sx(i);
    g += `<g class="chip" style="--i:${i};--c:${SHELF_COLOR[i]}"><rect x="${x}" y="${shelfY}" width="${cw}" height="${ch}" rx="8"/><text class="lb" x="${x + cw / 2}" y="${shelfY + 18}" text-anchor="middle">${n}</text></g>`;
    g += `<text class="lb inslot" style="--i:${i}" x="${W / 2}" y="${slotY + 22}" text-anchor="middle">${n}</text>`;
  });
  return `<svg viewBox="0 0 ${W} ${by + bh + 2}" role="img" aria-label="The second brain stays the same; models take turns in its model slot">${g}</svg>`;
}

// ── the bench loop: five steps on a ring, a light going round ──────────────────────────────
const STEPS: [string, string][] = [
  ["Freeze", "same tasks every time"],
  ["Run", "fresh sandbox per attempt"],
  ["Grade", "tests, scripts, yes/no checks"],
  ["Record", "score, cost, tokens, time"],
  ["Decide", "I make the change"],
];
const LOOP_S = 12;
function loop(): string {
  const cx = 260, cy = 210, r = 130;
  let g = `<circle class="ring" cx="${cx}" cy="${cy}" r="${r}" pathLength="1"/>`;
  STEPS.forEach(([name, what], i) => {
    const a = -Math.PI / 2 + (i * 2 * Math.PI) / STEPS.length;
    const x = cx + r * Math.cos(a), y = cy + r * Math.sin(a);
    const lx = cx + (r + 22) * Math.cos(a), ly = cy + (r + 22) * Math.sin(a);
    const anchor = Math.abs(Math.cos(a)) < 0.2 ? "middle" : Math.cos(a) > 0 ? "start" : "end";
    const dy = Math.sin(a) < -0.9 ? -14 : Math.sin(a) > 0.5 ? 12 : 0;
    g += `<g class="st" style="--d:${(i * LOOP_S) / STEPS.length}s"><circle class="halo" cx="${x}" cy="${y}" r="12"/><circle class="node" cx="${x}" cy="${y}" r="4.5"/>
      <text class="lb" x="${lx}" y="${ly + dy}" text-anchor="${anchor}">${name}</text><text class="ax" x="${lx}" y="${ly + dy + 15}" text-anchor="${anchor}">${what}</text></g>`;
  });
  g += `<circle class="orb" r="4"><animateMotion dur="${LOOP_S}s" repeatCount="indefinite" path="M ${cx} ${cy - r} A ${r} ${r} 0 1 1 ${cx - 0.01} ${cy - r}"/></circle>`;
  g += `<text class="c1" x="${cx}" y="${cy - 2}" text-anchor="middle">${nTasks} tasks</text><text class="ax" x="${cx}" y="${cy + 18}" text-anchor="middle">again, for every new model</text>`;
  return `<svg viewBox="-120 0 760 430" role="img" aria-label="The bench loop: freeze, run, grade, record, decide, and again">${g}</svg>`;
}

// ── tools → models, with today's list price on each model ──────────────────────────────────
function relations(): string {
  const agents = Object.entries(cat.agents as Record<string, any>);
  const rowH = 34, H = models.length * rowH + 16, W = 600;
  const ay = (i: number) => 10 + ((i + 0.5) * (H - 20)) / agents.length;
  const my = (i: number) => 10 + (i + 0.5) * rowH;
  let lines = "", nodes = "";
  models.forEach((m, i) => {
    const ai = agents.findIndex(([k]) => k === m.agent);
    const on = m.status === "tested";
    lines += `<path pathLength="1" style="--i:${i}" class="lk ${m.status}" d="M150 ${ay(ai)} C 240 ${ay(ai)}, 250 ${my(i)}, 330 ${my(i)}" stroke="${on ? m.color : "var(--dim)"}"/>`;
    const price = m.price_in != null ? `$${m.price_in.toFixed(2)} / $${m.price_out.toFixed(2)}` : "";
    nodes += `<g class="nd" style="--i:${i}"><circle cx="336" cy="${my(i)}" r="${on ? 4 : 3}" fill="${on ? m.color : "var(--dim)"}"/>
      <text x="348" y="${my(i) - 1}" class="${on ? "lb" : "lb off"}">${m.name}</text>
      <text x="348" y="${my(i) + 13}" class="ax">${m.status === "judge" ? "judge · " : m.status === "available" ? "next · " : ""}${price}</text></g>`;
  });
  agents.forEach(([k, a], i) => {
    nodes += `<g class="nd" style="--i:0"><circle cx="146" cy="${ay(i)}" r="4" fill="${k === "claude-code" ? "var(--bright)" : "var(--dim)"}"/><text x="134" y="${ay(i) - 1}" class="lb" text-anchor="end">${a.name.split(" (")[0]}</text><text x="134" y="${ay(i) + 13}" class="ax" text-anchor="end">${a.state}</text></g>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Which agent tool runs which model, with list prices">${lines}${nodes}</svg>`;
}

// everything the metrics chart needs, as one JSON blob for the client script
const payload = {
  models: models.map(({ id, name, provider, family, version, status, color }) => ({ id, name, provider, family, version, status, color })),
  latest: Object.fromEntries(tested.map((m) => [m, { ...summ[m], date: cycle.date }])),
  trends: data.trends,
  prices: (data as any).prices ?? [],
  suites: { vault: "Recall", finance: "Recall (PT)", ops: "Operations", code: "Code fixes" },
};
---

<Layout title="Model bench · Gil Neto" description="How my second brain stays independent of any one AI model, and how I test the newest models on a fixed set of internal tasks." noindex>
<nav class="top" id="nav"><a href="/"><b>Gil Neto</b></a><ul><li><a href="#agnostic">Model-agnostic</a></li><li><a href="#bench">The bench</a></li><li><a href="#metrics">Metrics</a></li><li><a href="/work">Work with me</a></li></ul></nav>

<section class="hero lab-hero" id="top">
  <div class="copy">
    <h1 class="wipe"><span>Any model.</span> Measured on the same work, every time.</h1>
    <p data-reveal>My second brain doesn't depend on one AI model. The model is a setting, and I choose it with numbers: the newest models, run on a fixed set of internal tasks, with every result kept.</p>
    <div class="links" data-reveal><a href="#metrics">See the metrics</a><a href="#agnostic">How it stays agnostic</a></div>
  </div>
  <div class="swapper" aria-hidden="true" data-reveal>
    <small>model in use</small>
    <div class="swap">{["Opus 5.5", "Fable 5.2", "Haiku 5.5", "Gemini 4 Neon", "Sonnet 5.5", "Gemini 4 Hydrogen"].map((n, i) => <b style={`--i:${i}`}>{n}</b>)}</div>
    <span>everything else stays the same</span>
  </div>
</section>

<div class="topic">
<section class="band chapter" id="agnostic" style="--cc:var(--pink)">
  <div class="copy">
    <h2 class="wipe">The brain stays. <span>The model plugs in.</span></h2>
    <p data-reveal>Notes, tools and rules are plain files, and one seam names the model. Any model, from any company, goes in the same slot. Nothing else changes.</p>
    <p class="quiet" data-reveal>Still to do: the night jobs call one agent tool directly in 14 places. Moving them behind the seam is next.</p>
  </div>
  <div class="viz plug" data-draw><Fragment set:html={plug()} /></div>
</section>
</div>

<div class="topic">
<section class="band chapter" id="bench" style="--cc:var(--blue)">
  <div class="copy">
    <h2 class="wipe">One loop, <span>over and over</span>.</h2>
    <p data-reveal>Each new model, and each new version of the task set, goes round the same loop. The tasks are internal and consistent, private, so no model has seen them in training.</p>
    <p class="quiet" data-reveal>Every attempt runs in a throwaway sandbox, and nothing is left behind.</p>
  </div>
  <div class="viz loop" data-draw><Fragment set:html={loop()} /></div>
</section>

<section class="lab-pair">
  <div class="copy">
    <h2 class="wipe small">The models, and the tools that run them.</h2>
    <p data-reveal>Coloured: tested. Grey: next in line, or the judge. The judge always comes from a company with no model in that round.</p>
    <p class="quiet" data-reveal>List price per million tokens, OpenRouter, {dateLabel(data.exported)}.</p>
  </div>
  <div class="viz rel" data-draw><Fragment set:html={relations()} /></div>
</section>
</div>

<div class="topic">
<section class="band chapter" id="metrics" style="--cc:var(--amber)">
  <div class="copy">
    <h2 class="wipe">Every round, <span>every metric</span>.</h2>
    <p data-reveal>{dateLabel(cycle.date)} was round one: {tested.length} models, {nTasks} tasks, {summ[tested[0]].attempts} attempts each. Mostly single lookups, so the scores sit close. Each new round adds a point per model, so a model getting better or worse, cheaper or pricier, shows up here.</p>
  </div>
</section>

<section class="explorer" id="explorer" data-reveal>
  <div class="ctl">
    <div class="seg" role="tablist" aria-label="View">
      <button type="button" data-view="scatter" class="on">Score against cost</button>
      <button type="button" data-view="bars">Each model</button>
      <button type="button" data-view="time">Over time</button>
    </div>
    <div class="seg metric" role="tablist" aria-label="Metric">
      <button type="button" data-metric="score" class="on">Score</button>
      <button type="button" data-metric="usd">Cost per task</button>
      <button type="button" data-metric="solved">Cost per solved task</button>
      <button type="button" data-metric="tokens">Tokens per task</button>
      <button type="button" data-metric="spread">Spread</button>
      <button type="button" data-metric="price">List price</button>
    </div>
  </div>
  <div class="ctl filters">
    <div class="chips" data-filter="provider"></div>
    <div class="chips" data-filter="family"></div>
    <label class="tog"><input type="checkbox" id="latestOnly" checked /> Latest version of each family</label>
  </div>
  <div class="chart"><svg id="chart" role="img" aria-label="Benchmark metrics"></svg><div class="tip" id="tip" hidden></div></div>
  <p class="quiet" id="chartNote"></p>
</section>
<p class="lab-note" data-reveal>Round one note: a grader bug of mine scored six operation attempts of Haiku, Sonnet and Opus at zero, fixed during the run before Fable's turn. Costs are what the same run would cost on each company's API; the Claude runs used a subscription.</p>
</div>

<footer><span>© 2026 Gil Neto</span><span><a href="/">gil-neto.com</a></span><span>Data as of {dateLabel(data.exported)}</span></footer>
<script type="application/json" id="bench-data" set:html={JSON.stringify(payload)}></script>
</Layout>

<script>
  // Reveal once when a block enters the viewport.
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -12% 0px" });
  document.querySelectorAll("[data-reveal], .wipe, [data-draw]").forEach((el) => io.observe(el));
  const nav = document.getElementById("nav");
  addEventListener("scroll", () => nav?.classList.toggle("scrolled", scrollY > 8), { passive: true });

  // ── metrics explorer ─────────────────────────────────────────────────────────────────────
  const D = JSON.parse(document.getElementById("bench-data")!.textContent!);
  const svg = document.getElementById("chart") as unknown as SVGSVGElement;
  const tip = document.getElementById("tip")!;
  const note = document.getElementById("chartNote")!;
  const M: Record<string, any> = Object.fromEntries(D.models.map((m: any) => [m.id, m]));
  const st = { view: "scatter", metric: "score", providers: new Set<string>(), families: new Set<string>(), latest: true };
  const money = (v: number) => (v < 0.1 ? `$${v.toFixed(3)}` : `$${v.toFixed(2)}`);
  const METRIC: Record<string, { label: string; fmt: (v: number) => string; higher: boolean }> = {
    score: { label: "Score", fmt: (v) => `${Math.round(v * 100)}%`, higher: true },
    usd: { label: "API-equivalent USD per task", fmt: money, higher: false },
    solved: { label: "API-equivalent USD per solved task", fmt: money, higher: false },
    tokens: { label: "Tokens per task", fmt: (v) => `${Math.round(v / 1000)}k`, higher: false },
    spread: { label: "Spread across attempts (lower is steadier)", fmt: (v) => `${Math.round(v * 100)} pts`, higher: false },
    price: { label: "List price, USD per 1M output tokens", fmt: (v) => `$${v.toFixed(2)}`, higher: false },
  };
  const vnum = (v: string) => v.split(".").map(Number).reduce((a, b, i) => a + b / 100 ** i, 0);
  const latestIds = () => {
    const best: Record<string, any> = {};
    for (const m of D.models) if (!best[m.family] || vnum(m.version) > vnum(best[m.family].version)) best[m.family] = m;
    return new Set(Object.values(best).map((m: any) => m.id));
  };
  const visible = () => {
    const Lt = latestIds();
    return D.models.filter((m: any) => (!st.providers.size || st.providers.has(m.provider)) && (!st.families.size || st.families.has(m.family)) && (!st.latest || Lt.has(m.id)));
  };
  const latestVal = (id: string, k: string): number | null => {
    const s = D.latest[id];
    if (k === "price") { const p = D.prices.filter((p: any) => p.model === id).sort((a: any, b: any) => a.date.localeCompare(b.date)).pop(); return p ? p.out : null; }
    if (!s) return null;
    return k === "score" ? s.score : k === "usd" ? s.cost_per_task : k === "solved" ? s.cost_per_solved : k === "tokens" ? s.tokens_per_task : k === "spread" ? s.spread : null;
  };
  const series = (id: string, k: string): { date: string; v: number }[] => {
    if (k === "price") return D.prices.filter((p: any) => p.model === id).map((p: any) => ({ date: p.date, v: p.out }));
    const t = D.trends[id] ?? [];
    const key = k === "usd" ? "usd" : k === "tokens" ? "tokens" : k === "score" ? "score" : null;
    if (key) return t.map((p: any) => ({ date: p.date, v: p[key] }));
    const v = latestVal(id, k); return v == null ? [] : [{ date: D.latest[id].date, v }];
  };

  const NS = "http://www.w3.org/2000/svg";
  const el = (tag: string, attrs: Record<string, any> = {}, text?: string) => {
    const e = document.createElementNS(NS, tag); for (const [a, v] of Object.entries(attrs)) e.setAttribute(a, String(v)); if (text != null) e.textContent = text; return e;
  };
  const showTip = (ev: Event, html: string) => {
    tip.innerHTML = html; tip.hidden = false;
    const box = (svg.parentElement as HTMLElement).getBoundingClientRect();
    const r = (ev.currentTarget as Element).getBoundingClientRect();
    tip.style.left = `${Math.max(170, Math.min(r.left - box.left + r.width / 2, box.width - 170))}px`; tip.style.top = `${r.top - box.top - 12}px`;
  };
  const hideTip = () => (tip.hidden = true);
  const hover = (node: Element, html: string) => {
    node.setAttribute("tabindex", "0");
    node.addEventListener("mouseenter", (e) => showTip(e, html)); node.addEventListener("focus", (e) => showTip(e, html));
    node.addEventListener("mouseleave", hideTip); node.addEventListener("blur", hideTip);
  };
  const detail = (id: string) => {
    const s = D.latest[id], m = M[id];
    if (!s) return `<b style="color:${m.color}">${m.name}</b><br>not tested yet`;
    const kinds = Object.entries(D.suites).map(([k, l]) => `${l} ${Math.round((s.suite[k] ?? 0) * 100)}%`).join(" · ");
    return `<b style="color:${m.color}">${m.name}</b><br>${METRIC.score.fmt(s.score)} · ${money(s.cost_per_task)} per task · median ${Math.round(s.secs ?? 0)} s<br><span>${kinds}</span>`;
  };

  // drawn at its real pixel width, so type stays 11–13px on any screen
  let W = 1000; const H = 340, L = 56, R = 16, T = 16, B = 46;
  function draw() {
    W = Math.max(520, Math.round((svg.parentElement as HTMLElement).clientWidth));
    svg.setAttribute("viewBox", `0 0 ${W} ${H}`); svg.setAttribute("width", String(W)); svg.setAttribute("height", String(H));
    svg.replaceChildren(); hideTip();
    const vis = visible();
    document.querySelector(".metric")!.classList.toggle("off", st.view === "scatter");
    if (st.view === "scatter") return scatter(vis);
    if (st.view === "bars") return bars(vis);
    return time(vis);
  }
  function axisY(lo0: number, hi0: number, fmt: (v: number) => string) {
    // round the range to a "nice" step (1, 2, 2.5 or 5 x 10^n) so ticks read as plain numbers
    const raw = (hi0 - lo0) / 4 || 1, mag = 10 ** Math.floor(Math.log10(raw));
    const step = [1, 2, 2.5, 5, 10].map((f) => f * mag).find((v) => v >= raw)!;
    const lo = Math.floor(lo0 / step) * step, hi = Math.ceil(hi0 / step) * step;
    const Y = (v: number) => T + (1 - (v - lo) / (hi - lo || 1)) * (H - T - B);
    for (let v = lo; v <= hi + step / 2; v += step) svg.append(el("line", { x1: L, x2: W - R, y1: Y(v), y2: Y(v), class: "gl" }), el("text", { x: L - 8, y: Y(v) + 4, class: "ax", "text-anchor": "end" }, fmt(v)));
    return Y;
  }
  function scatter(vis: any[]) {
    const all = D.models.filter((m: any) => D.latest[m.id]);
    const pts = vis.filter((m) => D.latest[m.id]);
    note.textContent = pts.length ? "Latest round. Up is better, left is cheaper. Hover a model for its breakdown. Faint dots: filtered out." : "No tested model in this selection yet.";
    if (!all.length) return;
    const xs = all.map((m: any) => D.latest[m.id].cost_per_task);   // fixed scale: filtering never moves a point
    const lo = Math.log10(Math.min(...xs) / 2), hi = Math.log10(Math.max(...xs) * 2);
    const X = (v: number) => L + ((Math.log10(v) - lo) / (hi - lo || 1)) * (W - L - R - 110);
    const Y = axisY(0.8, 1, METRIC.score.fmt);
    for (const v of [0.001, 0.01, 0.1, 1, 10]) if (Math.log10(v) > lo && Math.log10(v) < hi) svg.append(el("text", { x: X(v), y: H - B + 18, class: "ax", "text-anchor": "middle" }, money(v)));
    svg.append(el("text", { x: L, y: H - 6, class: "ax" }, "API-equivalent cost per task, log scale →"));
    const shown = new Set(pts.map((m) => m.id));
    all.filter((m: any) => !shown.has(m.id)).forEach((m: any) => { const s = D.latest[m.id]; svg.append(el("circle", { cx: X(s.cost_per_task), cy: Y(s.score), r: 3.5, fill: m.color, opacity: 0.2 })); });
    pts.forEach((m, i) => {
      const s = D.latest[m.id], g = el("g", { class: "pt", style: `--i:${i}` });
      g.append(el("circle", { cx: X(s.cost_per_task), cy: Y(s.score), r: 14, fill: m.color, opacity: 0.12 }), el("circle", { cx: X(s.cost_per_task), cy: Y(s.score), r: 4.5, fill: m.color }),
        el("text", { x: X(s.cost_per_task) + 10, y: Y(s.score) + 4, class: "lb" }, m.name));
      hover(g, detail(m.id)); svg.append(g);
    });
  }
  function bars(vis: any[]) {
    const k = st.metric, f = METRIC[k];
    const rows = vis.map((m) => ({ m, v: latestVal(m.id, k) })).filter((r) => r.v != null) as { m: any; v: number }[];
    rows.sort((a, b) => (f.higher ? b.v - a.v : a.v - b.v));
    note.textContent = rows.length ? `${f.label}, latest round. ${f.higher ? "Higher" : "Lower"} is better.` : "No data for this selection yet.";
    if (!rows.length) return;
    const allv = D.models.map((m: any) => latestVal(m.id, k)).filter((v: any) => v != null) as number[];   // fixed scale across filters
    const hi = Math.max(...allv) * 1.12 || 1, lo = k === "score" ? Math.max(0, Math.min(...allv) - 0.1) : 0;
    const Y = axisY(lo, hi, f.fmt);
    const bw = Math.max(10, Math.min(28, (W - L - R) / rows.length - 40));
    rows.forEach(({ m, v }, i) => {
      const x = L + ((i + 0.5) * (W - L - R)) / rows.length;
      const g = el("g", { class: "bar", style: `--i:${i}` });
      g.append(el("rect", { x: x - bw / 2, y: Y(v), width: bw, height: Math.max(H - B - Y(v), 2), rx: 3, fill: m.color }),
        el("text", { x, y: Y(v) - 7, class: "ax hi", "text-anchor": "middle" }, f.fmt(v)));
      const cut = m.name.lastIndexOf(" "), two = rows.length > 6 && cut > 0;
      g.append(el("text", { x, y: H - B + 17, class: "ax", "text-anchor": "middle" }, two ? m.name.slice(0, cut) : m.name));
      if (two) g.append(el("text", { x, y: H - B + 31, class: "ax", "text-anchor": "middle" }, m.name.slice(cut + 1)));
      hover(g, detail(m.id)); svg.append(g);
    });
  }
  function time(vis: any[]) {
    const k = st.metric, f = METRIC[k];
    const ser = vis.map((m) => ({ m, s: series(m.id, k) })).filter((r) => r.s.length);
    const allSer = D.models.map((m: any) => series(m.id, k)).filter((x: any[]) => x.length);   // fixed axes across filters
    const dates = [...new Set(allSer.flat().map((p: any) => p.date))].sort() as string[];
    note.textContent = !ser.length ? "No data for this selection yet." : dates.length < 2 ? `${f.label}. One round so far: every new round adds a point, and the lines start at the second.` : `${f.label} across ${dates.length} ${k === "price" ? "snapshots" : "rounds"}.${k === "price" ? "" : " Only tasks that stayed identical count."}`;
    if (!ser.length) return;
    const vals = allSer.flat().map((p: any) => p.v) as number[];
    let lo = Math.min(...vals), hi = Math.max(...vals); const pad = (hi - lo) * 0.15 || hi * 0.1 || 1; lo = Math.max(0, lo - pad); hi += pad;
    const Y = axisY(lo, hi, f.fmt);
    const X = (d: string) => dates.length < 2 ? L + (W - L - R - 170) / 2 : L + 16 + (dates.indexOf(d) / (dates.length - 1)) * (W - L - R - 190);
    dates.forEach((d) => svg.append(el("text", { x: X(d), y: H - B + 18, class: "ax", "text-anchor": "middle" }, new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }))));
    const labels: { y: number; x: number; text: string; color: string }[] = [];
    ser.forEach(({ m, s }, i) => {
      if (s.length > 1) svg.append(el("polyline", { points: s.map((p) => `${X(p.date)},${Y(p.v)}`).join(" "), fill: "none", stroke: m.color, "stroke-width": 1.5, class: "tl", pathLength: 1 }));
      s.forEach((p) => { const c = el("circle", { cx: X(p.date), cy: Y(p.v), r: 4, fill: m.color, class: "pt", style: `--i:${i}` }); hover(c, `<b style="color:${m.color}">${m.name}</b><br>${new Date(p.date + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })}: ${f.fmt(p.v)}`); svg.append(c); });
      const last = s[s.length - 1];
      labels.push({ y: Y(last.v) + 4, x: X(last.date) + 10, text: `${m.name} ${f.fmt(last.v)}`, color: m.color });
    });
    // end labels: keep their order, push apart to 19px, then pull the column back inside the plot
    labels.sort((a, b) => a.y - b.y);
    labels.forEach((l, i) => { if (i) l.y = Math.max(l.y, labels[i - 1].y + 15); });
    for (let i = labels.length - 1; i >= 0; i--) labels[i].y = Math.min(labels[i].y, i === labels.length - 1 ? H - B : labels[i + 1].y - 15);
    labels.forEach((l) => svg.append(el("text", { x: l.x, y: l.y, class: "lb sm", style: `fill:${l.color}` }, l.text)));
  }

  // controls
  const chips = (key: "providers" | "families", values: string[], host: Element, colorOf?: (v: string) => string) => {
    host.replaceChildren();
    values.forEach((v) => {
      const b = document.createElement("button"); b.type = "button"; b.textContent = v; b.setAttribute("aria-pressed", "false");
      if (colorOf) b.style.setProperty("--c", colorOf(v));
      b.onclick = () => { const s = st[key]; s.has(v) ? s.delete(v) : s.add(v); b.setAttribute("aria-pressed", String(s.has(v))); draw(); };
      host.append(b);
    });
  };
  chips("providers", [...new Set(D.models.map((m: any) => m.provider))] as string[], document.querySelector('[data-filter="provider"]')!);
  chips("families", [...new Set(D.models.map((m: any) => m.family))] as string[], document.querySelector('[data-filter="family"]')!, (f) => D.models.find((m: any) => m.family === f).color);
  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((b) => (b.onclick = () => { st.view = b.dataset.view!; document.querySelectorAll("[data-view]").forEach((x) => x.classList.toggle("on", x === b)); draw(); }));
  document.querySelectorAll<HTMLButtonElement>("[data-metric]").forEach((b) => (b.onclick = () => { st.metric = b.dataset.metric!; document.querySelectorAll("[data-metric]").forEach((x) => x.classList.toggle("on", x === b)); draw(); }));
  (document.getElementById("latestOnly") as HTMLInputElement).onchange = (e) => { st.latest = (e.target as HTMLInputElement).checked; draw(); };
  draw();
  let rz = 0; new ResizeObserver(() => { cancelAnimationFrame(rz); rz = requestAnimationFrame(draw); }).observe(svg.parentElement as HTMLElement);
</script>

<style>
