---
// Unlisted: no link from the site, noindex, kept out of the sitemap (Gil, 2026-11-25).
// Data: src/data/model-bench.json, written by `python3 report.py --export` in the model-bench repo.
// Visual identity = the home page: chapters with a colour glow, big type, little text per screen,
// motion only upward or in depth (Gil's taste), triggered once when a block scrolls into view.
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
import "../../styles/home.css";
import data from "../../data/model-bench.json";

type Summ = { score: number; suite: Record<string, number>; attempts: number; rounds: number[];
  spread: number; cost_per_task: number; cost_per_solved: number | null; secs: number | null; tokens_per_task: number };

const cat = data.catalog;
const models = cat.models as any[];
const byId = Object.fromEntries(models.map((m) => [m.id, m]));
const cycle = data.cycles[data.cycles.length - 1];
const summ = cycle.summary as Record<string, Summ>;
const tested = Object.keys(summ).sort((a, b) => summ[b].score - summ[a].score);
const COLOR: Record<string, string> = {
  "claude-fable-5-2": "var(--amber)", "claude-opus-5-5": "var(--blue)",
  "claude-sonnet-5-5": "var(--lav)", "claude-haiku-5-5": "var(--teal)",
};
const col = (id: string) => COLOR[id] ?? "var(--dim)";
const nm = (id: string) => byId[id]?.name ?? id;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const usd = (v: number) => (v < 0.1 ? `$${v.toFixed(3)}` : `$${v.toFixed(2)}`);
const SUITES = ["vault", "finance", "ops", "code"];
const SUITE_LABEL: Record<string, string> = { vault: "Recall", finance: "Recall (PT)", ops: "Operations", code: "Code fixes" };
const nTasks = Object.values(cycle.suites as Record<string, number>).reduce((a, b) => a + b, 0);
const dateLabel = (d: string) => new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

// The stack: six slabs, top to bottom. The top two are the ones that change.
const LAYERS: [string, string, boolean][] = [
  ["Model", "one setting per role", true],
  ["Agent tool", "Claude Code, Gemini CLI, a neutral agent", true],
  ["Seam", "one env file, one adapter per tool", false],
  ["Rules", "AGENTS.md, plain text", false],
  ["Tools", "index, lint, search, no model inside", false],
  ["Notes", "Markdown in git", false],
];
const SWAP = ["Opus 5.5", "Fable 5.2", "Haiku 5.5", "Gemini 4 Neon", "Sonnet 5.5", "Gemini 4 Hydrogen"];

// Score against cost: log x. Points rise into place.
function scatter(): string {
  const W = 620, H = 340, L = 50, R = 120, T = 24, B = 50;
  const xs = tested.map((m) => summ[m].cost_per_task);
  const lo = Math.log10(Math.min(...xs) / 2), hi = Math.log10(Math.max(...xs) * 2);
  const X = (v: number) => L + ((Math.log10(v) - lo) / (hi - lo)) * (W - L - R);
  const Y = (v: number) => T + (1 - (v - 0.8) / 0.2) * (H - T - B);
  let g = "";
  for (const v of [0.8, 0.9, 1]) g += `<line x1="${L}" x2="${W - R + 80}" y1="${Y(v)}" y2="${Y(v)}" class="gl"/><text x="${L - 10}" y="${Y(v) + 4}" class="ax" text-anchor="end">${pct(v)}</text>`;
  for (const v of [0.01, 0.1, 1]) if (Math.log10(v) > lo && Math.log10(v) < hi) g += `<text x="${X(v)}" y="${H - B + 22}" class="ax" text-anchor="middle">${usd(v)}</text>`;
  g += `<text x="${L}" y="${H - 6}" class="ax">cost per task, log scale</text>`;
  tested.forEach((m, i) => {
    const s = summ[m], x = X(s.cost_per_task), y = Y(s.score);
    g += `<g class="pt" style="--i:${i}"><circle cx="${x}" cy="${y}" r="22" fill="${col(m)}" opacity=".12"/><circle cx="${x}" cy="${y}" r="6" fill="${col(m)}"/>`;
    g += `<text x="${x + 14}" y="${y - 6}" class="lb">${nm(m)}</text><text x="${x + 14}" y="${y + 12}" class="ax">${pct(s.score)} · ${usd(s.cost_per_task)}</text></g>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Score against cost per task">${g}</svg>`;
}

// Tools to models: lines draw themselves (stroke-dashoffset), nodes fade up.
function relations(): string {
  const agents = Object.entries(cat.agents as Record<string, any>);
  const rowH = 38, H = models.length * rowH + 20, W = 620;
  const ay = (i: number) => 10 + ((i + 0.5) * (H - 20)) / agents.length;
  const my = (i: number) => 10 + (i + 0.5) * rowH;
  let lines = "", nodes = "";
  models.forEach((m, i) => {
    const ai = agents.findIndex(([k]) => k === m.agent);
    const on = m.status === "tested";
    lines += `<path pathLength="1" style="--i:${i}" class="ln ${m.status}" d="M168 ${ay(ai)} C 280 ${ay(ai)}, 300 ${my(i)}, 400 ${my(i)}" stroke="${on ? col(m.id) : "var(--dim)"}"/>`;
    nodes += `<g class="nd" style="--i:${i}"><circle cx="408" cy="${my(i)}" r="${on ? 5 : 3.5}" fill="${on ? col(m.id) : "var(--dim)"}"/><text x="422" y="${my(i) + 5}" class="${on ? "lb" : "lb off"}">${m.name}</text></g>`;
  });
  agents.forEach(([k, a]) => {
    const i = agents.findIndex(([kk]) => kk === k);
    nodes += `<g class="nd" style="--i:0"><circle cx="160" cy="${ay(i)}" r="5" fill="${k === "claude-code" ? "var(--bright)" : "var(--dim)"}"/><text x="146" y="${ay(i) - 2}" class="lb" text-anchor="end">${a.name.split(" (")[0]}</text><text x="146" y="${ay(i) + 16}" class="ax" text-anchor="end">${a.state}</text></g>`;
  });
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Which agent tool runs which model">${lines}${nodes}</svg>`;
}

// Cost per solved task: vertical columns that grow upward.
const maxSolved = Math.max(...tested.map((m) => summ[m].cost_per_solved ?? 0));
const bySolved = tested.slice().sort((a, b) => (summ[a].cost_per_solved ?? 0) - (summ[b].cost_per_solved ?? 0));
const nCycles = data.cycles.length;
---

<Layout title="Model bench · Gil Neto" description="How my second brain stays independent of any one AI model, and how I test the newest models on a fixed set of internal tasks." noindex>
<nav class="top" id="nav"><a href="/"><b>Gil Neto</b></a><ul><li><a href="#agnostic">Model-agnostic</a></li><li><a href="#bench">The bench</a></li><li><a href="#results">Results</a></li><li><a href="/work">Work with me</a></li></ul></nav>

<section class="hero lab-hero" id="top">
  <div class="copy">
    <h1 class="wipe"><span>Any model.</span> Measured on the same work, every time.</h1>
    <p data-reveal>My second brain doesn't depend on one AI model. The model is a setting, and I choose it with numbers: the newest models, run on a fixed set of internal tasks, with every result kept.</p>
    <div class="links" data-reveal><a href="#results">See the results</a><a href="#agnostic">How it stays agnostic</a></div>
  </div>
  <div class="swapper" aria-hidden="true" data-reveal>
    <small>model in use</small>
    <div class="swap">{SWAP.map((n, i) => <b style={`--i:${i}`}>{n}</b>)}</div>
    <span>everything else stays the same</span>
  </div>
</section>

<div class="topic">
<section class="band chapter" id="agnostic" style="--cc:var(--pink)">
  <div class="copy">
    <h2 class="wipe">Six layers. <span>Two of them</span> can change.</h2>
    <p data-reveal>Notes, tools and rules are plain files. One seam names the agent tool and the model. Swap those two, and the rest moves as it is.</p>
    <p class="quiet" data-reveal>Still to do: the night jobs call one agent tool directly in 14 places. Moving them behind the seam is next.</p>
  </div>
  <div class="slabs">
    {LAYERS.map(([name, what, swap], i) => (
      <div class={swap ? "slab live" : "slab"} style={`--i:${LAYERS.length - 1 - i}`}>
        <b>{name}</b><span>{what}</span>
      </div>
    ))}
  </div>
</section>
</div>

<div class="topic">
<section class="band chapter" id="bench" style="--cc:var(--blue)">
  <div class="copy">
    <h2 class="wipe">The same <span>{nTasks} tasks</span>, for every model.</h2>
    <p data-reveal>A fixed set of internal, consistent tasks, private, so no model has seen them in training. Each attempt runs in a throwaway sandbox, and nothing is left behind.</p>
  </div>
  <ol class="chain">
    <li><b>Freeze</b><span>one versioned task set, the same between runs</span></li>
    <li><b>Run</b><span>each model, in a fresh sandbox per attempt</span></li>
    <li><b>Grade</b><span>tests and scripts; a judge only applies fixed yes/no checks</span></li>
    <li><b>Record</b><span>score, cost, tokens, time, the tool's version</span></li>
    <li><b>Decide</b><span>the report recommends; I change a model myself</span></li>
  </ol>
</section>

<section class="lab-pair">
  <div class="copy">
    <h2 class="wipe small">Models, and the tools that run them.</h2>
    <p data-reveal>Lit: tested. Grey: available, next in line. The judge comes from a company with no model in that round.</p>
    <ul class="prices" data-reveal>{models.map((m) => (
      <li><i style={`background:${m.status === "tested" ? col(m.id) : "var(--line)"}`}></i><b>{m.name}</b><span>{m.status}</span><em>{m.price_in != null ? `$${m.price_in.toFixed(2)} / $${m.price_out.toFixed(2)}` : ""}</em></li>
    ))}</ul>
    <p class="quiet" data-reveal>List price per million tokens, in / out, OpenRouter, {dateLabel(data.exported)}.</p>
  </div>
  <div class="viz rel" data-draw><Fragment set:html={relations()} /></div>
</section>
</div>

<div class="topic">
<section class="band chapter" id="results" style="--cc:var(--amber)">
  <div class="copy">
    <h2 class="wipe">First round. <span>Close</span>, by design.</h2>
    <p data-reveal>{dateLabel(cycle.date)}, bench-{cycle.bench}: {tested.length} models, {nTasks} tasks, {summ[tested[0]].attempts} attempts each. Mostly single lookups, so the scores sit close together. The next set adds harder, multi-step tasks.</p>
    <div class="stats" data-reveal>{tested.map((m) => (
      <div><b style={`color:${col(m)}`}>{pct(summ[m].score)}</b><span>{nm(m)}</span></div>
    ))}</div>
  </div>
  <div class="viz" data-draw><Fragment set:html={scatter()} /></div>
</section>

<section class="lab-grid3">
  <div>
    <h3>Cost per solved task</h3>
    <div class="cols" data-draw>{bySolved.map((m, i) => (
      <div style={`--i:${i};--h:${Math.max(((summ[m].cost_per_solved ?? 0) / maxSolved) * 100, 2)}%;--c:${col(m)}`}><b>{usd(summ[m].cost_per_solved ?? 0)}</b><i></i><span>{nm(m)}</span></div>
    ))}</div>
  </div>
  <div data-reveal>
    <h3>Score by kind of task</h3>
    <div class="dots">
      <div class="drow head"><span></span>{SUITES.map((x) => <span>{SUITE_LABEL[x]}</span>)}</div>
      {tested.map((m) => (
        <div class="drow"><span>{nm(m)}</span>{SUITES.map((x) => (
          <span><i style={`--s:${summ[m].suite[x] ?? 0};--c:${col(m)}`}></i><small>{pct(summ[m].suite[x] ?? 0)}</small></span>
        ))}</div>
      ))}
    </div>
  </div>
  <div>
    <h3>Steady across attempts?</h3>
    <div class="cols range" data-draw>{tested.map((m, i) => {
      const lo = Math.min(...summ[m].rounds), hi = Math.max(...summ[m].rounds);
      return <div style={`--i:${i};--lo:${(lo - 0.8) * 500}%;--hi:${(hi - 0.8) * 500}%;--c:${col(m)}`}><b>{pct(lo)}–{pct(hi)}</b><i></i><span>{nm(m)}</span></div>;
    })}</div>
  </div>
</section>
<p class="lab-note" data-reveal>A grader bug of mine scored six operation attempts of Haiku, Sonnet and Opus at zero. It was fixed during the run, before Fable's turn. Costs are what the same run would cost on each company's API; the Claude runs used a subscription.</p>
</div>

<div class="topic">
<section class="list" id="time">
  <h2 class="wipe">Over time</h2>
  <p class="lab-lead" data-reveal>{nCycles < 2 ? "One round so far. Every new round adds a point per model: better or worse, cheaper or pricier. Only tasks that stayed identical count, so a new task set never looks like a model change." : `${nCycles} rounds so far.`}</p>
  <div class="rows">{tested.map((m) => {
    const t = (data.trends as any)[m] ?? [];
    return <div class="row" data-reveal><span class="when">{t.map((p: any) => dateLabel(p.date)).join(" · ")}</span><span class="what"><i class="dot" style={`background:${col(m)}`}></i>{nm(m)}</span><span class="why">{t.map((p: any) => `${pct(p.score)} · ${usd(p.usd)} per task · ${Math.round(p.tokens / 1000)}k tokens`).join(" → ")}</span></div>;
  })}</div>
</section>
</div>

<footer><span>© 2026 Gil Neto</span><span><a href="/">gil-neto.com</a></span><span>Data as of {dateLabel(data.exported)}</span></footer>
</Layout>

<script>
  // Reveal once when a block enters the viewport. Vertical and depth motion only.
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { rootMargin: "0px 0px -12% 0px" });
  document.querySelectorAll("[data-reveal], .wipe, [data-draw], .chain, .slabs").forEach((el) => io.observe(el));
  const nav = document.getElementById("nav");
  addEventListener("scroll", () => nav?.classList.toggle("scrolled", scrollY > 8), { passive: true });
</script>

<style>
  /* hero: the line, and the one thing that moves on its own: the model setting changing while nothing else does */
  .lab-hero { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.9fr); }
  .lab-hero h1 { max-width: 15ch; }
  .swapper { display: grid; gap: 14px; justify-items: start; padding-left: clamp(0px, 3vw, 48px); border-left: 1px solid var(--line); }
  .swapper small, .swapper span { font-size: 14px; color: var(--dim); }
  .swap { position: relative; height: 1.45em; line-height: 1.3; font-size: clamp(1.8rem, 3vw, 2.8rem); letter-spacing: -0.03em; overflow: hidden; width: 100%; }
  .swap b { position: absolute; left: 0; top: 0; font-weight: 500; color: var(--bright); opacity: 0; transform: translateY(100%); animation: swap 18s var(--ease) infinite; animation-delay: calc(var(--i) * 3s); white-space: nowrap; }
  @keyframes swap { 0% { opacity: 0; transform: translateY(100%); } 3%, 13% { opacity: 1; transform: none; } 16%, 100% { opacity: 0; transform: translateY(-100%); } }

  /* heading wipe: the line rises out of a mask, bottom first */
  .wipe { clip-path: inset(0 0 100% 0); transform: translateY(16px); transition: clip-path 1s var(--ease), transform 1s var(--ease); }
  .wipe.in { clip-path: inset(0 0 -0.25em 0); transform: none; }
  .wipe.small { font-size: clamp(1.6rem, 2.4vw, 2.4rem); max-width: 18ch; }
  p.quiet { color: var(--dim); font-size: 15px; }

  /* the six slabs: they stack from the bottom up, in depth; the two that can change are lit in the chapter colour */
  .slabs { display: grid; gap: 10px; }
  .slab { display: grid; grid-template-columns: minmax(96px, 0.5fr) 1fr; align-items: baseline; gap: 16px; padding: 16px 22px; border: 1px solid var(--line); border-radius: 14px; background: color-mix(in srgb, var(--bg) 70%, transparent); opacity: 0; transform: translateY(24px) scale(.97); transition: opacity .7s var(--ease), transform .7s var(--ease), border-color .6s; transition-delay: calc(var(--i) * 110ms); }
  .slabs.in .slab { opacity: 1; transform: none; }
  .slab b { font-weight: 500; color: var(--bright); font-size: 18px; }
  .slab span { color: var(--dim); font-size: 15px; }
  .slab.live { border-color: color-mix(in srgb, var(--cc) 55%, var(--line)); box-shadow: 0 16px 40px -28px var(--cc); }
  .slab.live b { color: var(--cc); }

  /* method: one vertical chain; the connector fills downward as each step arrives */
  .chain { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .chain li { position: relative; display: grid; gap: 4px; padding-left: 30px; opacity: 0; transform: translateY(18px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
  .chain li:nth-child(2) { transition-delay: 140ms; } .chain li:nth-child(3) { transition-delay: 280ms; } .chain li:nth-child(4) { transition-delay: 420ms; } .chain li:nth-child(5) { transition-delay: 560ms; }
  .chain li::before { content: ""; position: absolute; left: 0; top: 8px; width: 9px; height: 9px; border-radius: 50%; border: 1px solid var(--cc); background: var(--bg); }
  .chain li + li::after { content: ""; position: absolute; left: 4px; top: -24px; width: 1px; height: 30px; background: var(--cc); transform: scaleY(0); transform-origin: top; transition: transform .5s var(--ease); transition-delay: inherit; }
  .chain.in li { opacity: 1; transform: none; }
  .chain.in li + li::after { transform: scaleY(1); }
  .chain b { color: var(--bright); font-weight: 500; font-size: 19px; }
  .chain span { color: var(--dim); font-size: 15px; }

  /* models + tools */
  .lab-pair { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(32px, 4vw, 72px); align-items: center; padding-block: clamp(64px, 11vh, 140px) 0; }
  .prices { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; font-size: 14px; }
  .prices li { display: grid; grid-template-columns: 10px 1fr auto auto; align-items: center; gap: 12px; color: var(--dim); }
  .prices i { width: 7px; height: 7px; border-radius: 50%; }
  .prices b { font-weight: 400; color: var(--text); }
  .prices em { font-style: normal; font-variant-numeric: tabular-nums; color: var(--dim); }
  .viz svg { width: 100%; height: auto; display: block; overflow: visible; }
  .viz :global(.gl) { stroke: var(--line); }
  .viz :global(.ax) { fill: var(--dim); font-size: 12px; }
  .viz :global(.lb) { fill: var(--bright); font-size: 15px; }
  .viz :global(.lb.off) { fill: var(--dim); }
  .rel :global(.ln) { fill: none; stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.2s var(--ease); transition-delay: calc(var(--i) * 80ms); }
  .rel :global(.ln.available), .rel :global(.ln.judge) { stroke-width: 1; opacity: .5; }
  .rel.in :global(.ln) { stroke-dashoffset: 0; }
  .viz :global(.nd), .viz :global(.pt) { opacity: 0; transform: translateY(10px); transition: opacity .6s var(--ease), transform .6s var(--ease); transition-delay: calc(300ms + var(--i) * 80ms); }
  .viz.in :global(.nd), .viz.in :global(.pt) { opacity: 1; transform: none; }

  /* results */
  #results .stats b { font-size: 34px; }
  .lab-grid3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: clamp(32px, 4vw, 64px); padding-block: clamp(64px, 10vh, 120px) 0; }
  .lab-grid3 h3 { font-size: 15px; font-weight: 400; color: var(--dim); margin: 0 0 22px; }
  .cols { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 14px; height: 220px; align-items: end; }
  .cols > div { display: grid; grid-template-rows: auto 1fr auto; height: 100%; gap: 8px; text-align: center; }
  .cols b { font-weight: 400; font-size: 13px; color: var(--bright); font-variant-numeric: tabular-nums; align-self: end; }
  .cols i { align-self: end; justify-self: center; width: 14px; height: var(--h); border-radius: 7px 7px 2px 2px; background: var(--c); transform: scaleY(0); transform-origin: bottom; transition: transform 1s var(--ease); transition-delay: calc(var(--i) * 120ms); }
  .cols span { font-size: 13px; color: var(--dim); }
  .cols.in i { transform: scaleY(1); }
  .cols.range i { position: relative; height: 100%; width: 2px; background: var(--line); transform: none; border-radius: 0; }
  .cols.range i::after { content: ""; position: absolute; left: -5px; right: -5px; bottom: var(--lo); height: max(calc(var(--hi) - var(--lo)), 6px); border-radius: 6px; background: var(--c); transform: scaleY(0); transform-origin: bottom; transition: transform 1s var(--ease); transition-delay: calc(var(--i) * 120ms); }
  .cols.range.in i::after { transform: scaleY(1); }
  .dots { display: grid; gap: 14px; font-size: 13px; }
  .drow { display: grid; grid-template-columns: 82px repeat(4, 1fr); align-items: center; gap: 6px; text-align: center; }
  .drow > span:first-child { text-align: left; color: var(--text); }
  .drow.head span { color: var(--dim); font-size: 12px; line-height: 1.2; }
  .drow span { display: grid; justify-items: center; gap: 4px; }
  .drow i { width: calc(10px + var(--s) * 18px); height: calc(10px + var(--s) * 18px); border-radius: 50%; background: var(--c); opacity: calc(var(--s) * 1.4 - .4); }
  .drow small { color: var(--dim); font-variant-numeric: tabular-nums; }
  .lab-note { padding: clamp(40px, 7vh, 72px) var(--pad) 0; color: var(--dim); font-size: 14px; max-width: calc(80ch + 2 * var(--pad)); }
  .lab-lead { color: var(--dim); max-width: 64ch; }
  .dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 10px; vertical-align: middle; }

  @media (max-width: 900px) {
    .lab-hero { grid-template-columns: 1fr; }
    .swapper { padding-left: 0; border-left: 0; border-top: 1px solid var(--line); padding-top: 20px; }
    .lab-pair { grid-template-columns: 1fr; }
    .slab { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wipe, .slab, .chain li, .viz :global(.nd), .viz :global(.pt), .cols i, .cols.range i::after { transition: none; clip-path: none; opacity: 1; transform: none; }
    .rel :global(.ln) { stroke-dashoffset: 0; transition: none; }
    .swap b { animation: none; } .swap b:first-child { opacity: 1; transform: none; }
  }
</style>
