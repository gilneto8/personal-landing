---
import NetworkBackground from "../components/NetworkBackground";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Senior engineer with 12 years' experience. Founder-Engineer based in Lisbon, building B2B utilities end-to-end on a single Hetzner VPS. Open to senior IC, staff, fractional CTO, and contract roles.",
  ogImage = "/og-image.png",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="author" content="Gil Neto" />
    <meta
      name="keywords"
      content="founder-engineer, fractional CTO, senior full-stack architect, systems architect, B2B SaaS, Next.js, TypeScript, Python, Temporal, Hetzner, Lisbon, EU remote, hire"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>

    <!-- Open Graph & Twitter Card -->
    <meta property="og:site_name" content="Gil Neto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD: Person + WebSite + FAQ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://gil-neto.com/#gil",
            name: "Gil Neto",
            url: "https://gil-neto.com",
            jobTitle: "Founder-Engineer & Full-Stack Architect",
            description:
              "Senior engineer with 12 years' experience building and operating B2B utilities end-to-end. Currently running three products on a single Hetzner VPS: Kelaro (accounting-automation SaaS), Augur (GRC tooling, EU data residency), and Koa (PDF extraction engine).",
            email: "gilneto8.work@gmail.com",
            telephone: "+351914847254",
            address: {
              "@type": "PostalAddress",
              addressLocality: "Lisbon",
              addressCountry: "PT",
            },
            knowsAbout: [
              "Software Architecture",
              "B2B SaaS",
              "Full-Stack Development",
              "Systems Architecture",
              "Infrastructure Engineering",
              "TypeScript",
              "Python",
              "Next.js",
              "React",
              "Node.js",
              "Nest.js",
              "Fastify",
              "Flask",
              "FastAPI",
              "Temporal",
              "PostgreSQL",
              "MongoDB",
              "Redis",
              "BullMQ",
              "Kafka",
              "Docker",
              "Nginx",
              "Hetzner",
              "AWS",
              "GCP",
              "Stripe",
              "OAuth 2.0",
              "Open Banking",
              "PSD2",
              "LLM Integration",
            ],
            alumniOf: {
              "@type": "CollegeOrUniversity",
              name: "Faculdade de Ciências e Tecnologia - Universidade Nova de Lisboa",
            },
            seeks: [
              "Senior IC roles",
              "Staff engineer roles",
              "Fractional CTO engagements",
              "Contract engagements",
            ],
            sameAs: [
              "https://github.com/gilneto8",
              "https://www.linkedin.com/in/gil-neto-7b44946a",
              "https://dev.to/gilneto8",
            ],
            workLocation: {
              "@type": "Place",
              name: "Lisbon, Portugal · Remote (EU)",
            },
          },
          {
            "@type": "WebSite",
            "@id": "https://gil-neto.com/#website",
            url: "https://gil-neto.com",
            name: "Gil Neto — Founder-Engineer & Full-Stack Architect",
            description:
              "Portfolio and writings of Gil Neto, a Lisbon-based founder-engineer building B2B utilities end-to-end.",
            inLanguage: "en",
            publisher: { "@id": "https://gil-neto.com/#gil" },
          },
          {
            "@type": "FAQPage",
            mainEntity: [
              {
                "@type": "Question",
                name: "Who is Gil Neto?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Gil Neto is a senior software engineer with 12 years' experience, based in Lisbon, Portugal. He works as a Founder-Engineer building and operating B2B utilities solo, from infrastructure to UI. Currently running three products on a single Hetzner VPS: Kelaro (accounting-automation SaaS), Augur (GRC tooling for EU-regulated buyers), and Koa (deterministic PDF extraction engine).",
                },
              },
              {
                "@type": "Question",
                name: "What kind of roles is Gil Neto open to?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Senior individual contributor, staff engineer, fractional CTO, and contract engagements. Remote-first across EU timezones, based in Lisbon.",
                },
              },
              {
                "@type": "Question",
                name: "What is Gil Neto's primary tech stack?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "TypeScript, Python, and SQL as primary languages. Next.js, React, Node.js, Nest.js, Fastify, Flask, and Temporal for runtime. Docker, Nginx, Hetzner, PostgreSQL, MongoDB, Redis, BullMQ, Kafka on AWS and GCP for infrastructure. Integrations with Stripe, OAuth 2.0, Open Banking (PSD2), Brevo, and Umami.",
                },
              },
              {
                "@type": "Question",
                name: "What is Gil Neto's technical philosophy?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Infrastructure-first: own the boundary from DNS to UI, everything containerized and reproducible. AI-augmented execution: leverage coding agents to eliminate boilerplate and focus on architecture and business logic. Scope discipline: build stateless, low-liability utilities with operational impact, and kill projects fast when market signal is wrong.",
                },
              },
              {
                "@type": "Question",
                name: "What products has Gil Neto shipped?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Three live products on a single Hetzner CCX23 VPS: Kelaro (kelaro.io) — accounting-automation SaaS in closed beta; Augur (tryaugur.eu) — GRC tooling for AI governance with EU data residency; Koa — a deterministic PDF bank-statement extraction engine powering Kelaro. Previously: Lead Engineer at Opplane driving monolith-to-microservices migration and LLM-integration pipelines; Front-end Lead at Glartek shipping the core industrial-IoT product.",
                },
              },
              {
                "@type": "Question",
                name: "Where is Gil Neto based and what languages does he speak?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Based in Lisbon, Portugal. Native Portuguese, proficient English, elementary Spanish. Available for remote work across EU timezones.",
                },
              },
            ],
          },
        ],
      })}
    />
  </head>
  <body class="font-sans antialiased relative">
    <div class="fixed inset-0 z-0">
      <NetworkBackground client:only="react" />
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  body {
    font-family: "Inter", sans-serif;
  }
</style>
