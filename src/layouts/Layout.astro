---
import NetworkBackground from "../components/NetworkBackground";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Senior software engineer with 12 years' experience, working on AI products. Founder-Engineer based in Lisbon, building agent memory and knowledge systems - capture, retrieval, evaluation - alongside B2B utilities shipped end-to-end. Open to fractional build and advisory engagements.",
  ogImage = "/og-image.png",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="author" content="Gil Neto" />
    <meta
      name="keywords"
      content="founder-engineer, AI product engineer, AI engineer Lisbon, agent memory, long-term memory for LLM agents, AI second brain, exocortex, persistent memory architecture, personal knowledge management, context engineering, semantic retrieval, LLM application engineer, fractional build, fractional CTO, fractional AI CTO, systems architect, RAG, model evaluation, eval harness, AI agents, document extraction, B2B SaaS, Next.js, TypeScript, Python, Temporal, Lisbon, EU remote, hire"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Gil Neto — Writing"
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{title}</title>

    <!-- Open Graph & Twitter Card -->
    <meta property="og:site_name" content="Gil Neto" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD: Person + WebSite + FAQ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": "https://gil-neto.com/#gil",
            name: "Gil Neto",
            url: "https://gil-neto.com",
            jobTitle: "Founder-Engineer & Senior Software Engineer, AI Products",
            description:
              "Senior engineer with 12 years' experience building LLM-backed systems where the model does judgment and deterministic code does correctness. Current focus is the memory and knowledge layer such systems run on: capture, storage, retrieval and staleness detection for an LLM agent's long-term memory, running daily as a second-brain system. Also builds and operates B2B utilities end-to-end: Kelaro (accounting-automation SaaS) and Koa (deterministic document-extraction engine, the deliberate alternative to vision-LLM extraction).",
            email: "gilneto8.work@gmail.com",
            telephone: "+351914847254",
            address: {
              "@type": "PostalAddress",
              addressLocality: "Lisbon",
              addressCountry: "PT",
            },
            knowsAbout: [
              "Software Architecture",
              "B2B SaaS",
              "Full-Stack Development",
              "Systems Architecture",
              "Infrastructure Engineering",
              "TypeScript",
              "Python",
              "Next.js",
              "React",
              "Node.js",
              "Nest.js",
              "Fastify",
              "Flask",
              "FastAPI",
              "Temporal",
              "PostgreSQL",
              "MongoDB",
              "Redis",
              "BullMQ",
              "Kafka",
              "Docker",
              "Nginx",
              "AWS",
              "GCP",
              "Stripe",
              "OAuth 2.0",
              "Open Banking",
              "PSD2",
              "LLM Integration",
              "LLM Application Architecture",
              "Retrieval-Augmented Generation",
              "pgvector",
              "Model Evaluation",
              "Eval Harnesses",
              "AI Agents",
              "Agent Orchestration",
              "Document Extraction",
              "Deterministic NLP",
              "Agent Memory",
              "Long-Term Memory for LLM Agents",
              "Persistent Memory Architecture",
              "Personal Knowledge Management",
              "Second Brain Systems",
              "Knowledge Base Architecture",
              "Context Engineering",
              "Semantic Retrieval",
            ],
            alumniOf: {
              "@type": "CollegeOrUniversity",
              name: "Faculdade de Ciências e Tecnologia - Universidade Nova de Lisboa",
            },
            seeks: [
              "Fractional build engagements",
              "Advisory engagements",
              "AI product engineering engagements",
              "Agent memory and knowledge system engagements",
              "Fractional CTO for AI products",
            ],
            sameAs: [
              "https://github.com/gilneto8",
              "https://www.linkedin.com/in/gil-neto-7b44946a",
              "https://dev.to/gilneto8",
            ],
            workLocation: {
              "@type": "Place",
              name: "Lisbon, Portugal · Remote (EU)",
            },
          },
          {
            "@type": "WebSite",
            "@id": "https://gil-neto.com/#website",
            url: "https://gil-neto.com",
            name: "Gil Neto — Founder-Engineer & Senior Software Engineer, AI Products",
            description:
              "Portfolio and writings of Gil Neto, a Lisbon-based founder-engineer and senior software engineer working on AI products, building B2B utilities and LLM-backed systems end-to-end.",
            inLanguage: "en",
            publisher: { "@id": "https://gil-neto.com/#gil" },
          },
          {
            "@type": "FAQPage",
            mainEntity: [
              {
                "@type": "Question",
                name: "Who is Gil Neto?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Gil Neto is a senior software engineer with 12 years' experience, based in Lisbon, Portugal. He works as a Founder-Engineer, building and operating B2B utilities solo from infrastructure to UI, and as a senior software engineer on AI products, building LLM-backed systems for other people. His current focus is the memory and knowledge layer that LLM systems run on: how an agent captures what it learns, where that knowledge is stored, how it is retrieved, and how staleness is detected. He runs a second-brain system on those rules daily, and builds Kelaro (accounting-automation SaaS) and Koa (deterministic document-extraction engine).",
                },
              },
              {
                "@type": "Question",
                name: "Does Gil Neto work on AI and LLM products?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Yes. Gil Neto works as a senior software engineer on AI products, building LLM-backed systems where the model handles judgment and deterministic code handles correctness. That covers agent memory and persistent knowledge architecture, LLM application architecture, retrieval-augmented generation, model evaluation and eval harnesses as release gates, agent orchestration, and document extraction. He is available for fractional build and advisory engagements on AI products, based in Lisbon and remote across EU timezones.",
                },
              },
              {
                "@type": "Question",
                name: "What AI systems has Gil Neto built?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Koa, a deterministic document-extraction engine built as the deliberate alternative to vision-LLM extraction for bank statements: it forces balances to reconcile and refuses loudly rather than returning a plausible total. Kelaro's LLM-backed pipeline, running on durable Temporal workflows with the model kept out of the arithmetic. An agentic development pipeline called midas, which resolves every open decision before anything is specified, built on top of Matt Pocock's wayfinder model. A second-brain system giving an LLM agent persistent long-term memory: a markdown knowledge base the agent reads and writes, with capture, routing and checkpointing enforced by lifecycle hooks rather than prompts, retrieval split between generated indexes for state and vector search for specific facts, and a scored nightly eval that detects when the index has gone stale. Earlier, the LLM-integration layer at Opplane between 2021 and 2026.",
                },
              },
              {
                "@type": "Question",
                name: "What kind of work is Gil Neto open to?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Fractional build and advisory engagements: architecture, the first working version, and a handover. Remote-first across EU timezones, based in Lisbon.",
                },
              },
              {
                "@type": "Question",
                name: "What is Gil Neto's primary tech stack?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "TypeScript, Python, and SQL as primary languages. Next.js, React, Node.js, Nest.js, Fastify, Flask, and Temporal for runtime. Docker, Nginx, PostgreSQL, pgvector, MongoDB, Redis, BullMQ, Kafka on AWS and GCP for infrastructure. Integrations with Stripe, OAuth 2.0, Open Banking (PSD2), Brevo, and Umami.",
                },
              },
              {
                "@type": "Question",
                name: "What is Gil Neto's technical philosophy?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Memory as infrastructure: an agent that forgets is a demo, so capture, routing and evaluation are enforced by the harness while judgment stays the model's job. Infrastructure-first: own the boundary from DNS to UI, everything containerized and reproducible. AI-augmented execution: leverage coding agents to eliminate boilerplate and focus on architecture and business logic.",
                },
              },
              {
                "@type": "Question",
                name: "What products has Gil Neto shipped?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Kelaro (kelaro.io) — accounting-automation SaaS in closed beta with active pilots in Portugal and the Netherlands; Koa — a deterministic PDF bank-statement extraction engine powering Kelaro, built as the alternative to vision-LLM extraction; and a second-brain memory system for an LLM agent, running daily and documented publicly. Previously: Lead Engineer at Opplane driving monolith-to-microservices migration and LLM-integration pipelines; Front-end Lead at Glartek shipping the core industrial-IoT product.",
                },
              },
              {
                "@type": "Question",
                name: "Where is Gil Neto based and what languages does he speak?",
                acceptedAnswer: {
                  "@type": "Answer",
                  text: "Based in Lisbon, Portugal. Native Portuguese, proficient English, elementary Spanish. Available for fractional build and advisory work across EU timezones.",
                },
              },
            ],
          },
        ],
      })}
    />
    {import.meta.env.PROD && import.meta.env.PUBLIC_UMAMI_SCRIPT_URL && import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
      <script defer src={import.meta.env.PUBLIC_UMAMI_SCRIPT_URL} data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}></script>
    )}
  </head>
  <body class="font-sans antialiased relative">
    <div class="fixed inset-0 z-0">
      <NetworkBackground client:only="react" />
    </div>
    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  body {
    font-family: "Inter", sans-serif;
  }
</style>
